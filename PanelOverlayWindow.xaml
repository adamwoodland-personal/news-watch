<Window x:Class="NewsWatch.PanelOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewsWatch Panels"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        FontFamily="Segoe UI">

    <!-- The window is only as tall as its panels and is hidden when there are
         none: a permanent full-height strip, even fully transparent, swallows
         mouse input in DirectX games running maximised-windowed. -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel x:Name="PanelHost" Width="380" Margin="16,16,0,16"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </ScrollViewer>
</Window>
