<Window x:Class="NewsWatch.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="900" Height="560"
        MinWidth="640" MinHeight="320"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Shared by the column header and the rows so they line up. -->
        <Style x:Key="ColLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="ShownText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shown}" Value="PANEL">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="14,7"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="HISTORY" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextDimBrush}"
                           FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Width="240" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Style="{StaticResource NeonTextBox}" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Search headlines and feeds" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <!-- ===== Table ===== -->
        <Border Grid.Row="1" Background="#0C1220" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}" Padding="14,9"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="3,3,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SEEN" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="1" Text="FEED" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="2" Text="HEADLINE" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="3" Text="PUBLISHED" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="4" Text="SHOWN AS" Style="{StaticResource ColLabel}"/>
                    </Grid>
                </Border>

                <ListBox x:Name="StoryList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource HistoryRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="StoryList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Summary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{Binding FeedBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Feed}" Foreground="{Binding FeedBrush}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                           Foreground="{StaticResource TextBrush}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding PublishedDisplay}"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Shown}" Style="{StaticResource ShownText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Row="1"
                           Text="No new stories since the app started."
                           Foreground="{StaticResource TextDimBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Double-click a story to open it in your browser. Kept in memory until NEWS//WATCH exits."
                       Foreground="{StaticResource TextDimBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,300,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenButton" Content="OPEN STORY" Style="{StaticResource NeonButton}"
                        Click="Open_Click" IsEnabled="False"/>
                <Button x:Name="ExportButton" Content="EXPORT CSV" Style="{StaticResource NeonButton}"
                        Margin="10,0,0,0" Click="Export_Click"/>
                <Button Content="CLOSE" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
