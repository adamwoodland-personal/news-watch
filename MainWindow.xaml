<Window x:Class="NewsWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NewsWatch.Models"
        Title="NEWS//WATCH"
        Width="1000" Height="600"
        MinWidth="780" MinHeight="420"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Status dot color by StatusDisplay -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="LIVE">
                    <Setter Property="Fill" Value="{StaticResource OnlineBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#22E584" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="ERROR">
                    <Setter Property="Fill" Value="{StaticResource OfflineBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3B5C" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="LIVE">
                    <Setter Property="Foreground" Value="{StaticResource OnlineBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="ERROR">
                    <Setter Property="Foreground" Value="{StaticResource OfflineBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FeedRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="16,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StatusDisplay}" Value="PAUSED">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4E7E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas" FontSize="20" FontWeight="Bold">
                        <Run Text="NEWS" Foreground="{StaticResource AccentBrush}"/><Run Text="//" Foreground="{StaticResource TextDimBrush}"/><Run Text="WATCH" Foreground="{StaticResource TextBrush}"/>
                    </TextBlock>
                    <TextBlock Text="FEED MONITOR" Foreground="{StaticResource TextDimBrush}"
                               FontSize="10" FontWeight="SemiBold" Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="HISTORY" Style="{StaticResource NeonButton}"
                            ToolTip="Every new story since the app started, including ones that didn't get a panel"
                            Click="History_Click"/>
                    <Button Content="⚙ SETTINGS" Style="{StaticResource NeonButton}" Margin="10,0,0,0"
                            Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Feed list ===== -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <ListBox x:Name="FeedList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource FeedRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="FeedList_MouseDoubleClick"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="FeedList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="FeedList_PreviewMouseMove"
                     Drop="FeedList_Drop">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:FeedEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.6*"/>
                                <ColumnDefinition Width="0.6*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" VerticalAlignment="Center"/>

                            <!-- Panel colour stripe, echoing the stripe on the panel itself. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="{Binding Swatch}"
                                           Margin="0,0,10,0" ToolTip="Panel colour"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FilterDisplay}" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                           ToolTip="Keyword filter: + only matching stories, − skipping some"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Url}" Foreground="{StaticResource TextDimBrush}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                       ToolTip="{Binding Url}"/>

                            <TextBlock Grid.Column="3" Text="{Binding IntervalDisplay}" Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                       ToolTip="Checked this often"/>

                            <TextBlock Grid.Column="4" Text="{Binding DetailDisplay}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                       ToolTip="Feed format and number of stories it lists, or why the last check failed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="ERROR">
                                                <Setter Property="Foreground" Value="{StaticResource OfflineBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="5" Text="{Binding LastCheckedDisplay}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontFamily="Consolas" FontSize="11"
                                       ToolTip="Last checked"/>

                            <TextBlock Grid.Column="6" Text="{Binding StatusDisplay}" Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="NO FEEDS CONFIGURED" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="Add an RSS, Atom or JSON feed (or a news site's address) below."
                           Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <!-- ===== Footer actions ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ ADD FEED" Style="{StaticResource NeonButton}" Click="Add_Click"/>
                    <Button x:Name="EditButton" Content="EDIT" Style="{StaticResource NeonButton}"
                            Margin="10,0,0,0" Click="Edit_Click" IsEnabled="False"/>
                    <Button x:Name="RemoveButton" Content="REMOVE" Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0" Click="Remove_Click" IsEnabled="False"/>
                    <Button Content="↻ CHECK NOW" Style="{StaticResource NeonButton}"
                            Margin="24,0,0,0" Click="CheckNow_Click"
                            ToolTip="Fetch every active feed now instead of waiting for its interval"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold">
                    <Hyperlink Foreground="{StaticResource TextDimBrush}"
                               TextDecorations="{x:Null}"
                               Click="ConfigFolder_Click">
                        <Hyperlink.Style>
                            <Style TargetType="Hyperlink">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Hyperlink.Style>
                        <Run Text="⌁ CONFIG FOLDER"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
